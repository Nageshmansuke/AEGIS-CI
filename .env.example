# ========================================================================
# HYDRA Environment Variables Template
# ========================================================================

# 1. Database Connection String
# For Production (Vercel / Neon Postgres):
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@your-neon-host.neon.tech/neondb?sslmode=require"
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# 2. Better-Auth Secret (Any secure random string, e.g. generated via openssl rand -hex 32)
BETTER_AUTH_SECRET="change-this-to-a-secure-random-32-byte-string"

# 3. Better-Auth URL
# Local: "http://localhost:3000"
# Production: "https://your-app-name.vercel.app"
BETTER_AUTH_URL="http://localhost:3000"

# 4. Google Gemini API Key (Obtain free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# 5. GitHub Personal Access Token (Optional: needed only for private repo cloning)
# GITHUB_TOKEN=""
